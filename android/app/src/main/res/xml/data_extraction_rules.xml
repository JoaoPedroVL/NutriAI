<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Não permite extração de dados via adb backup / transferência. -->
    <cloud-backup>
        <exclude
            domain="database"
            path="nutria.sqlite" />
        <exclude
            domain="database"
            path="nutria.sqlite-shm" />
        <exclude
            domain="database"
            path="nutria.sqlite-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="nutria.sqlite" />
        <exclude
            domain="database"
            path="nutria.sqlite-shm" />
        <exclude
            domain="database"
            path="nutria.sqlite-wal" />
    </device-transfer>
</data-extraction-rules>